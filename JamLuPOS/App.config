<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Change Data Source if needed: localhost, .\SQLEXPRESS, (localdb)\MSSQLLocalDB -->
    <add name="PosDb"
         connectionString="Data Source=localhost;Initial Catalog=lucero;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>